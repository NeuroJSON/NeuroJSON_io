# Where Node listens (Apache proxies to it in prod)
HOST=127.0.0.1
PORT=8090
BASE_PATH=/neurojson-storage

# Storage root. Dev on the Mac: ./storage-dev ; Zodiac: /local_mount/space/zodiac/1/users/neurojson/uploads
UPLOAD_ROOT=./storage-dev

# Browser origins allowed to upload (comma separated)
ALLOWED_ORIGINS=http://localhost:3000

# REN main API for pushes. EMPTY = pushes off (dev: REN pulls instead).
MAIN_API_URL=

# From the "Zodiac" block of backend/scripts/generate-upload-keys.js (same run as REN's keys)
UPLOAD_TOKEN_PUBLIC_KEYS='{"dev-2026-09":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
STORAGE_HMAC_ACTIVE_KID=dev-2026-09
STORAGE_HMAC_KEYS='{"dev-2026-09":"..."}'

# Limits
MAX_UPLOAD_BYTES=536870912000
DISK_RESERVE_PERCENT=5
